    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.4",
    "framer-motion": "^12.42.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.0.0",
    "next": "15.5.20",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.3.0",
