    "@testing-library/react": "^16.3.0",
    "@types/dom-speech-recognition": "^0.0.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
